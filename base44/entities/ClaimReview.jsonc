{
  "name": "ClaimReview",
  "type": "object",
  "title": "Claim Review",
  "description": "Core claim metadata and lifecycle state. Generated analyses and documents are stored in related entities.",
  "properties": {
    "claim_name": {
      "type": "string",
      "minLength": 1,
      "description": "Name or title of the claim"
    },
    "claim_number": {
      "type": "string",
      "minLength": 3,
      "description": "Display-formatted claim number"
    },
    "normalized_claim_number": {
      "type": "string",
      "description": "Uppercase alphanumeric claim number used for duplicate detection"
    },
    "date_of_loss": {
      "type": "string",
      "format": "date",
      "description": "Date the loss occurred"
    },
    "jurisdiction": {
      "type": "string",
      "description": "State or jurisdiction"
    },
    "line_of_business": {
      "type": "string",
      "enum": [
        "Commercial Auto",
        "Personal Auto",
        "General Liability",
        "Workers Compensation",
        "Property",
        "Professional Liability",
        "Product Liability",
        "Other"
      ],
      "description": "Line of business"
    },
    "insured_name": { "type": "string" },
    "claimant_name": { "type": "string" },
    "policy_limits": { "type": "string" },
    "current_demand": { "type": "string" },
    "reserve_amount": { "type": "string" },
    "defense_counsel": { "type": "string" },
    "claim_file_text": {
      "type": "string",
      "description": "Full text of the claim file"
    },
    "reviewer_notes": { "type": "string" },
    "selected_sections": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "analyzing", "reviewed", "archived", "failed"],
      "default": "draft"
    },
    "record_status": {
      "type": "string",
      "enum": ["active", "deleted"],
      "default": "active",
      "description": "Application lifecycle state used for recoverable deletion"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "deleted_at": {
      "type": "string",
      "description": "ISO timestamp recorded when a claim is soft-deleted"
    },
    "deletion_reason": {
      "type": "string",
      "maxLength": 500
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },

    "executive_summary": { "type": "string" },
    "coverage_summary": { "type": "string" },
    "coverage_issues": { "type": "string" },
    "liability_assessment": { "type": "string" },
    "damages_summary": { "type": "string" },
    "medical_treatment_summary": {
      "type": "string",
      "description": "Legacy medical treatment field"
    },
    "medical_timeline": { "type": "string" },
    "litigation_status": { "type": "string" },
    "venue_exposure_analysis": { "type": "string" },
    "exposure_analysis": { "type": "string" },
    "settlement_evaluation": { "type": "string" },
    "strengths": { "type": "string" },
    "weaknesses": { "type": "string" },
    "strengths_and_weaknesses": {
      "type": "string",
      "description": "Legacy combined field"
    },
    "red_flags": { "type": "string" },
    "missing_information": { "type": "string" },
    "recommended_next_steps": { "type": "string" },
    "suggested_follow_up_questions": { "type": "string" },
    "overall_claim_assessment": { "type": "string" },
    "supervisor_review": { "type": "string" },
    "venue_risk_level": {
      "type": "string",
      "enum": ["Low", "Moderate", "High", "Severe", "Unknown"]
    },
    "liability_allocation_summary": { "type": "string" },
    "confidence_level": {
      "type": "string",
      "enum": ["High", "Medium", "Low"]
    },
    "follow_up_messages": { "type": "string" },
    "readiness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "readiness_categories": {
      "type": "string",
      "description": "Legacy JSON array retained for existing reports"
    },
    "missing_requirements": {
      "type": "string",
      "description": "Legacy JSON array retained for existing reports"
    },
    "readiness_recommendation": { "type": "string" },
    "comparative_verdict_data": {
      "type": "string",
      "description": "Legacy JSON analysis field retained during migration"
    },
    "claim_knowledge": {
      "type": "string",
      "description": "Legacy JSON analysis field retained during migration"
    },
    "validation_engine_data": {
      "type": "string",
      "description": "Legacy JSON analysis field retained during migration"
    }
  },
  "required": [
    "claim_name",
    "claim_number",
    "date_of_loss",
    "jurisdiction",
    "line_of_business",
    "claim_file_text"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
